import os
import subprocess
import tempfile
import sys
from dotenv import load_dotenv
from openai import OpenAI

load_dotenv()

provider = os.getenv("AI_PROVIDER", "groq")
api_key = os.getenv("AI_API_KEY")
model_name = os.getenv("AI_MODEL", "openai/gpt-oss-120b")

if provider.lower() == "groq":
    base_url = "https://api.groq.com/openai/v1"
elif provider.lower() == "openai":
    base_url = "https://api.openai.com/v1"
else:
    base_url = "https://api.groq.com/openai/v1"

client = OpenAI(api_key=api_key, base_url=base_url)
print(f"[AGENT] Initialized using {provider} ({model_name})")

CRITIC_PROMPT = """
You are an expert Code Reviewer. Analyze the following Python code. 
Identify missing preconditions (input validation), postconditions (output validation), and potential edge cases.
Output a brief list of the flaws you found.
"""

BUILDER_PROMPT = """
You are an expert Software Engineer practicing "Design by Contract".
Based on the flaws identified, rewrite the code. 
RULES:
1. Add assert statements at the start of functions for PRECONDITIONS.
2. Add assert statements before returns for POSTCONDITIONS.
3. Add a test harness at the bottom with 3 test cases.
Output ONLY the valid, executable Python code. No markdown formatting.
"""

def run_agent(file_path):
    with open(file_path, "r", encoding="utf-8") as f:
        original_code = f.read()
    
    print(f"\n[CRITIC] Analyzing {file_path}...")
    
    critique_response = client.chat.completions.create(
        model=model_name,
        messages=[
            {"role": "system", "content": CRITIC_PROMPT},
            {"role": "user", "content": original_code}
        ],
        temperature=0.2
    )
    critique = critique_response.choices[0].message.content
    print(f"--- CRITIQUE ---\n{critique}\n")

    print("[BUILDER] Rewriting code...")
    
    refactor_response = client.chat.completions.create(
        model=model_name,
        messages=[
            {"role": "system", "content": BUILDER_PROMPT},
            {"role": "user", "content": f"Original Code:\n{original_code}\n\nCritique:\n{critique}"}
        ],
        temperature=0.2
    )
    refactored_code = refactor_response.choices[0].message.content
    
    if "```python" in refactored_code:
        refactored_code = refactored_code.split("```python")[1].split("```")[0]
    elif "```" in refactored_code:
        refactored_code = refactored_code.split("```")[1].split("```")[0]
        
    print(f"--- REFACTORED CODE ---\n{refactored_code}\n")

    print("[TESTER] Executing code...")
    
    with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False, encoding='utf-8') as f:
        f.write(refactored_code)
        temp_file = f.name
    
    env = os.environ.copy()
    env["PYTHONIOENCODING"] = "utf-8"

    try:
        result = subprocess.run(
            ["python", temp_file], 
            capture_output=True, 
            text=True, 
            timeout=10,
            env=env
        )
        
        if result.returncode == 0:
            print("[SUCCESS] Code passed all tests.")
        else:
            print(f"[FAILED] {result.stderr.strip()}")
            
    except Exception as e:
        print(f"[ERROR] Execution Error: {e}")
    finally:
        try:
            os.remove(temp_file)
        except FileNotFoundError:
            pass

if __name__ == "__main__":
    if len(sys.argv) > 1:
        target_file = sys.argv[1]
    else:
        target_file = "test_code.py"

    if not os.path.exists(target_file):
        print(f"Error: File '{target_file}' not found.")
    else:
        run_agent(target_file)
